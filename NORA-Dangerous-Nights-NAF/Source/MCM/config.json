{
  "modName": "RHI_NDN",
  "displayName": "NORA Dangerous Nights - NAF",
  "minMcmVersion": 3,
  "pluginRequirements": ["RHI_NDN.esp"],
  "content": [
    {
      "text": "<font size=\"36\"><p align=\"center\">NORA Dangerous Nights - NAF</p></font>",
      "type": "text",
      "html": true
    },
    {
      "text": "Version 1.1.0",
      "type": "text"
    },
    { "type": "spacer" },
    {
      "id": "fEnabled:Global",
      "text": "Mod enabled",
      "type": "switcher",
      "help": "Enables or disables wake-up event detection.",
      "valueOptions": { "sourceType": "ModSettingFloat" }
    },
    {
      "id": "fDebug:Global",
      "text": "Debug mode",
      "type": "switcher",
      "help": "Displays test results on screen and in the Papyrus log.",
      "valueOptions": { "sourceType": "ModSettingFloat" }
    }
  ],
  "pages": [
    {
      "pageDisplayName": "Chances",
      "content": [
        {
          "id": "fPlayerSettlement:Chances",
          "text": "Player settlement",
          "type": "slider",
          "help": "Event chance after waking up in a settlement owned by the player.",
          "valueOptions": { "min": 0, "max": 100, "step": 1, "sourceType": "ModSettingFloat" }
        },
        {
          "id": "fTown:Chances",
          "text": "Town or NPC settlement",
          "type": "slider",
          "help": "Event chance after waking up in a town or a settlement not owned by the player.",
          "valueOptions": { "min": 0, "max": 100, "step": 1, "sourceType": "ModSettingFloat" }
        },
        {
          "id": "fDungeon:Chances",
          "text": "Dungeon",
          "type": "slider",
          "help": "Event chance after waking up in a dungeon.",
          "valueOptions": { "min": 0, "max": 100, "step": 1, "sourceType": "ModSettingFloat" }
        },
        {
          "id": "fOutdoor:Chances",
          "text": "Outdoor or other location",
          "type": "slider",
          "help": "Event chance for locations that do not match any other category.",
          "valueOptions": { "min": 0, "max": 100, "step": 1, "sourceType": "ModSettingFloat" }
        }
      ]
    },
    {
      "pageDisplayName": "Encounter",
      "content": [
        {
          "id": "fMaxAttackers:Encounter",
          "text": "Maximum attackers",
          "type": "slider",
          "help": "Sets the maximum number of attackers that can appear. The actual number is randomly selected between 1 and this value.",
          "valueOptions": { "min": 1, "max": 3, "step": 1, "sourceType": "ModSettingFloat" }
        }
      ]
    },
    {
      "pageDisplayName": "Pervert",
      "content": [
        {
          "text": "Optional integration. Requires Pervert - Immersive Prostitution and Harassment v0.4.1 or later. When triggered, Pervert manages the abduction, dungeon, actors, scenes, return transport, and cleanup. NORA Dangerous Nights does not spawn its own attackers.",
          "type": "text"
        },
        { "type": "spacer" },
        {
          "id": "fPervertChance:Pervert",
          "text": "Pervert abduction chance",
          "type": "slider",
          "help": "Chance that an eligible wake-up event is handed over to Pervert's involuntary abduction scenario. This roll is evaluated before the normal NDN location chances. Set to 0 to disable the integration.",
          "valueOptions": { "min": 0, "max": 100, "step": 1, "sourceType": "ModSettingFloat" }
        }
      ]
    }
  ]
}
